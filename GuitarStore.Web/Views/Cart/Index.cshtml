@model GuitarStore.Web.Models.CartViewModel

<div class="container-fluid">
    <div class="well">
        @if (TempData["NewItem"] is string newItem)
        {
            <div class="alert alert-success">@newItem</div>
        }

        @if (Model.IsEmpty)
        {
            <div id="empty" class="alert alert-info">Your cart is empty.</div>
            <a class="btn btn-dark" asp-controller="Product" asp-action="List">Browse the catalog</a>
        }
        else
        {
            <form asp-controller="Cart" asp-action="UpdateQuantities" method="post">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Item Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Product" asp-action="Index" asp-route-id="@line.Product.Id">@line.Product.DisplayName</a>
                                    <input type="hidden" name="productIds" value="@line.Product.Id" />
                                </td>
                                <td>
                                    <input type="number" min="0" max="99" class="form-control" style="width: 6rem;"
                                            value="@line.Quantity" name="quantities" />
                                </td>
                                <td>@line.Product.Price.ToString("C")</td>
                                <td>@line.LineTotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3">Subtotal</th>
                            <th>@Model.SubTotal.ToString("C")</th>
                        </tr>
                        <tr>
                            <th colspan="3">Shipping and Handling</th>
                            <th>@Model.ShippingAndHandling.ToString("C")</th>
                        </tr>
                        <tr>
                            <th colspan="3">Tax</th>
                            <th>@Model.Tax.ToString("C")</th>
                        </tr>
                        <tr>
                            <th colspan="3">Total</th>
                            <th>@Model.Total.ToString("C")</th>
                        </tr>
                    </tfoot>
                </table>
                <button type="submit" class="btn btn-dark">Update Cart Quantities</button>
                <a class="btn btn-primary" asp-controller="Checkout" asp-action="Index">Check Out</a>
            </form>

            <form asp-controller="Cart" asp-action="ResetCart" method="post" class="mt-2">
                <button type="submit" class="btn btn-outline-secondary">Reset Cart</button>
            </form>
        }
    </div>
</div>
