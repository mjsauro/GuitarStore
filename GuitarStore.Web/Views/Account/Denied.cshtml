@{
    ViewData["Title"] = "Access Denied";
}

<div class="container">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header"><h3>Access Denied</h3></div>
                <div class="card-body">
                    <p class="lead">
                        You're signed in, but this area is for store administrators only.
                    </p>
                    <a class="btn btn-dark" asp-controller="Home" asp-action="Index">Back to the store</a>
                </div>
            </div>
        </div>
    </div>
</div>
