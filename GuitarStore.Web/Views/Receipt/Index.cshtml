@model GuitarStore.Web.Models.Order

<div class="container-fluid">
    <div class="well">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <h2>Thank you for your order!</h2>
                <p class="lead">
                    Your tracking number is <strong>@Model.TrackingNumber</strong> — keep it handy to look
                    this receipt up again.
                </p>

                <table class="table table-striped">
                    <tbody>
                        <tr><th>Tracking Number</th><td>@Model.TrackingNumber</td></tr>
                        <tr><th>Order Date</th><td>@Model.DateCreated.ToLocalTime().ToString("g")</td></tr>
                        <tr><th>Email</th><td>@Model.Email</td></tr>
                        <tr><th>Purchaser</th><td>@Model.PurchaserName</td></tr>
                        <tr><th>Ships To</th><td>@Model.ShippingAddress, @Model.ShippingCity, @Model.ShippingState @Model.ShippingPostalCode</td></tr>
                        <tr><th>Paid With</th><td>Card ending @Model.CardLastFour</td></tr>
                    </tbody>
                </table>

                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Item Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.LineItems)
                        {
                            <tr>
                                <td>@line.ProductName</td>
                                <td>@line.Quantity</td>
                                <td>@line.UnitPrice.ToString("C")</td>
                                <td>@line.LineTotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><th colspan="3">Subtotal</th><th>@Model.SubTotal.ToString("C")</th></tr>
                        <tr><th colspan="3">Shipping and Handling</th><th>@Model.ShippingAndHandling.ToString("C")</th></tr>
                        <tr><th colspan="3">Tax</th><th>@Model.Tax.ToString("C")</th></tr>
                        <tr><th colspan="3">Total</th><th>@Model.Total.ToString("C")</th></tr>
                    </tfoot>
                </table>

                <a class="btn btn-dark" asp-controller="Product" asp-action="List">Keep Shopping</a>
            </div>
        </div>
    </div>
</div>
