@model GuitarStore.Web.Models.Employee

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header"><h3>Delete @Model.FullName?</h3></div>
                <div class="card-body">
                    <p class="lead">This can't be undone.</p>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@Model.EmpId" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
