@model GuitarStore.Web.Models.Employee

<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

<input type="hidden" asp-for="EmpId" />

<div class="mb-3">
    <label asp-for="FirstName" class="form-label"></label>
    <input asp-for="FirstName" class="form-control" />
    <span asp-validation-for="FirstName" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="LastName" class="form-label"></label>
    <input asp-for="LastName" class="form-control" />
    <span asp-validation-for="LastName" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="DOB" class="form-label"></label>
    <input asp-for="DOB" class="form-control" type="date" />
    <span asp-validation-for="DOB" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Wage" class="form-label"></label>
    <input asp-for="Wage" class="form-control" type="number" step="0.01" min="0" />
    <span asp-validation-for="Wage" class="text-danger"></span>
</div>
