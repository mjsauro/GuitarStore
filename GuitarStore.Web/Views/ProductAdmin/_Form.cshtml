@model GuitarStore.Web.Models.Product
@{
    var productTypes = ViewBag.ProductTypes as string[] ?? [];
}

<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="ProductTypeName" class="form-label">Product Type</label>
    <select asp-for="ProductTypeName" class="form-select">
        @foreach (var type in productTypes)
        {
            <option value="@type">@type</option>
        }
    </select>
</div>
<div class="mb-3">
    <label asp-for="MakeName" class="form-label">Make</label>
    <input asp-for="MakeName" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="ManufacturerName" class="form-label">Manufacturer</label>
    <input asp-for="ManufacturerName" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Model" class="form-label">Model</label>
    <input asp-for="Model" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
</div>
<div class="mb-3">
    <label asp-for="Image" class="form-label">Image path</label>
    <input asp-for="Image" class="form-control" placeholder="/images/strat.jpg" />
</div>
<div class="mb-3">
    <label asp-for="Price" class="form-label"></label>
    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
    <span asp-validation-for="Price" class="text-danger"></span>
</div>
