{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GuitarStoreTableDataAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-2:910360776259:table/GuitarStore-Products",
        "arn:aws:dynamodb:us-east-2:910360776259:table/GuitarStore-Products/index/*",
        "arn:aws:dynamodb:us-east-2:910360776259:table/GuitarStore-Carts",
        "arn:aws:dynamodb:us-east-2:910360776259:table/GuitarStore-Orders",
        "arn:aws:dynamodb:us-east-2:910360776259:table/GuitarStore-Employees"
      ]
    }
  ]
}
