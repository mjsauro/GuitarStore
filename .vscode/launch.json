{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run GuitarStore (F5)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare and build",
      "program": "${workspaceFolder}/GuitarStore.Web/bin/Debug/net10.0/GuitarStore.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/GuitarStore.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5168"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/GuitarStore.Web/Views"
      }
    },
    {
      "name": "Attach to a running process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
